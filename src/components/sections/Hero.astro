---
/**
 * Hero — a "tese" da home: cookie mega recheado, assado no dia.
 * Ganchos de animação:
 *   data-float-scope  -> escopo do parallax
 *   data-float + data-speed -> cookies flutuantes (parallax + bob)
 *   data-reveal -> entra com fade+subida no load/scroll
 */
import Button from '../ui/Button.astro';

// Cookies/pedaços de chocolate desenhados inline (offline-safe, sem assets).
function cookieSVG(): string {
  return `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <circle cx="50" cy="50" r="45" fill="#E0A75B" stroke="#B77B33" stroke-width="5"/>
    <circle cx="38" cy="40" r="6" fill="#3B2314"/>
    <circle cx="63" cy="34" r="5" fill="#3B2314"/>
    <circle cx="58" cy="62" r="7" fill="#3B2314"/>
    <circle cx="34" cy="63" r="5" fill="#3B2314"/>
    <circle cx="72" cy="55" r="4" fill="#3B2314"/>
    <circle cx="40" cy="38" r="2" fill="#ffffff" opacity="0.25"/>
  </svg>`;
}
function chunkSVG(): string {
  return `<svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <rect x="18" y="18" width="64" height="64" rx="14" fill="#3B2314"/>
    <rect x="18" y="18" width="64" height="26" rx="14" fill="#ffffff" opacity="0.12"/>
  </svg>`;
}
---

<section class="hero" data-float-scope>
  <!-- brilhos de fundo -->
  <div class="hero__glow hero__glow--a" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--b" aria-hidden="true"></div>

  <div class="container hero__inner">
    <!-- Texto -->
    <div class="hero__content">
      <p class="hero__eyebrow" data-reveal>Cookies artesanais · São Paulo</p>

      <h1 class="hero__title" data-reveal data-reveal-delay="0.08">
        Cookies <span class="display-3d hero__accent">mega recheados</span>,
        assados no dia.
      </h1>

      <p class="hero__lead" data-reveal data-reveal-delay="0.16">
        Massa de verdade, recheio que escorre e chocolate de montão.
        Monte o seu, escolha o recheio e receba fresquinho na sua porta.
      </p>

      <div class="hero__actions" data-reveal data-reveal-delay="0.24">
        <Button href="#sabores" variant="primary" size="lg">Montar meu cookie</Button>
        <Button href="#sabores" variant="outline" size="lg">Ver sabores</Button>
      </div>

      <ul class="hero__trust" data-reveal data-reveal-delay="0.32">
        <li><span class="dot"></span> Massa artesanal</li>
        <li><span class="dot"></span> Recheio até a borda</li>
        <li><span class="dot"></span> Entrega refrigerada</li>
      </ul>
    </div>

    <!-- Visual -->
    <div class="hero__visual" data-reveal data-reveal-delay="0.1">
      <div class="hero__stage">
        <img
          class="hero__photo"
          src="https://images.unsplash.com/photo-1558961363-fa8fdf82db35?w=900&q=80&auto=format&fit=crop"
          alt="Cookie mega recheado de chocolate partido ao meio"
          width="560"
          height="560"
          fetchpriority="high"
          decoding="async"
        />

        <!-- selo giratório -->
        <div class="hero__badge" data-float data-speed="-0.08">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <defs>
              <path id="badgeCircle" d="M60,60 m-42,0 a42,42 0 1,1 84,0 a42,42 0 1,1 -84,0" />
            </defs>
            <circle cx="60" cy="60" r="58" fill="#FF6A00" />
            <text class="hero__badgetext">
              <textPath href="#badgeCircle" startOffset="0">
                RECHEIO ATÉ A BORDA · FEITO NO DIA ·
              </textPath>
            </text>
            <text x="60" y="66" text-anchor="middle" class="hero__badgecenter">🍪</text>
          </svg>
        </div>

        <!-- cookies flutuantes -->
        <span class="floatie floatie--1" data-float data-speed="0.22" aria-hidden="true" set:html={cookieSVG()} />
        <span class="floatie floatie--2" data-float data-speed="0.34" aria-hidden="true" set:html={cookieSVG()} />
        <span class="floatie floatie--3" data-float data-speed="0.14" aria-hidden="true" set:html={chunkSVG()} />
        <span class="floatie floatie--4" data-float data-speed="0.28" aria-hidden="true" set:html={chunkSVG()} />
      </div>
    </div>
  </div>

  <!-- indicador de scroll -->
  <div class="hero__scroll" aria-hidden="true">
    <span>role para explorar</span>
    <span class="hero__scrolldot"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem);
    isolation: isolate;
  }

  /* brilhos de fundo */
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    z-index: -1;
  }
  .hero__glow--a {
    width: 46vw; height: 46vw;
    top: -12vw; right: -8vw;
    background: rgb(var(--besties-butter-400-rgb) / 0.55);
  }
  .hero__glow--b {
    width: 40vw; height: 40vw;
    bottom: -14vw; left: -10vw;
    background: rgb(var(--besties-grape-300-rgb) / 0.5);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  /* texto */
  .hero__eyebrow {
    display: inline-block;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--step--1);
    color: var(--color-secondary);
    background: var(--color-surface-tint);
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
  }
  .hero__title {
    font-size: var(--step-6);
    margin-top: var(--space-md);
    color: var(--color-ink);
  }
  .hero__accent { color: var(--color-secondary); }
  .hero__lead {
    margin-top: var(--space-lg);
    max-width: 48ch;
    font-size: var(--step-1);
    color: var(--color-ink-soft);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }
  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
    margin-top: var(--space-xl);
    font-weight: var(--weight-semibold);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
  }
  .hero__trust li { display: flex; align-items: center; gap: 0.5rem; }
  .hero__trust .dot {
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: var(--color-primary);
  }

  /* visual */
  .hero__visual { position: relative; }
  .hero__stage {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .hero__photo {
    width: 86%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    box-shadow: var(--shadow-lg);
    border: 8px solid var(--color-surface);
  }

  /* selo giratório */
  .hero__badge {
    position: absolute;
    top: 2%; right: 4%;
    width: clamp(76px, 12vw, 120px);
    animation: badge-spin 14s linear infinite;
  }
  .hero__badge svg { width: 100%; height: auto; overflow: visible; }
  .hero__badgetext {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 9px;
    letter-spacing: 0.06em;
    fill: #2D0335;
  }
  .hero__badgecenter { font-size: 30px; }
  @keyframes badge-spin { to { transform: rotate(360deg); } }

  /* cookies flutuantes */
  .floatie { position: absolute; display: block; width: 68px; will-change: transform; }
  .floatie :global(svg) { width: 100%; height: auto; filter: drop-shadow(0 8px 14px rgb(var(--besties-grape-900-rgb) / 0.2)); }
  .floatie--1 { width: 84px; top: 4%;  left: -2%; }
  .floatie--2 { width: 60px; bottom: 8%; left: 6%; }
  .floatie--3 { width: 46px; bottom: 2%; right: 8%; }
  .floatie--4 { width: 38px; top: 16%; right: -2%; }

  /* indicador de scroll */
  .hero__scroll {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-content: center;
    margin-top: var(--space-2xl);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-ink-faint);
  }
  .hero__scrolldot {
    width: 22px; height: 34px;
    border: 2px solid var(--color-ink-faint);
    border-radius: 999px;
    position: relative;
  }
  .hero__scrolldot::after {
    content: '';
    position: absolute;
    top: 6px; left: 50%;
    width: 4px; height: 6px;
    background: var(--color-primary);
    border-radius: 999px;
    transform: translateX(-50%);
    animation: scroll-bob 1.6s ease-in-out infinite;
  }
  @keyframes scroll-bob { 0%,100% { top: 6px; opacity: 1; } 50% { top: 16px; opacity: 0.3; } }

  /* responsivo */
  @media (max-width: 860px) {
    .hero__inner { grid-template-columns: 1fr; text-align: center; }
    .hero__lead { margin-inline: auto; }
    .hero__actions, .hero__trust { justify-content: center; }
    .hero__visual { order: -1; max-width: 420px; margin-inline: auto; }
    .hero__scroll { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__badge, .hero__scrolldot::after { animation: none; }
  }
</style>

<script>
  // Fallback: se por algum motivo o GSAP não rodar, garante hero visível.
  window.addEventListener('load', () => {
    if (!document.documentElement.classList.contains('js')) return;
    setTimeout(() => {
      document.querySelectorAll<HTMLElement>('.hero [data-reveal]').forEach((el) => {
        if (getComputedStyle(el).opacity === '0') { el.style.opacity = '1'; el.style.transform = 'none'; }
      });
    }, 1500);
  });
</script>