---
/**
 * Footer — rodapé roxo profundo. Borda superior ondulada (recorte de cookie),
 * colunas de navegação/atendimento, newsletter (mock por enquanto) e bottom bar.
 */
import Button from '../ui/Button.astro';

const year = new Date().getFullYear();

const cols = [
  {
    title: 'Loja',
    links: [
      { href: '/loja', label: 'Todos os sabores' },
      { href: '/loja?tag=recheados', label: 'Mega recheados' },
      { href: '/loja?tag=brownie', label: 'Brownies' },
      { href: '/loja?tag=kits', label: 'Kits presente' },
    ],
  },
  {
    title: 'A marca',
    links: [
      { href: '/#sobre', label: 'Nossa história' },
      { href: '/#como-funciona', label: 'Como funciona' },
      { href: '/#ingredientes', label: 'Ingredientes' },
    ],
  },
  {
    title: 'Atendimento',
    links: [
      { href: 'https://wa.me/5511000000000', label: 'WhatsApp' },
      { href: '/#contato', label: 'Fale conosco' },
      { href: '/entregas', label: 'Entregas e prazos' },
      { href: '/trocas', label: 'Trocas' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__scallop" aria-hidden="true"></div>

  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <span class="wordmark site-footer__name">Besties</span>
      <p class="site-footer__blurb">
        Cookies artesanais mega recheados, feitos com massa de verdade.
        Assados no dia, entregues fresquinhos.
      </p>
      <form class="newsletter" data-newsletter>
        <label for="nl-email" class="newsletter__label">Receba lançamentos e mimos</label>
        <div class="newsletter__row">
          <input
            id="nl-email"
            type="email"
            name="email"
            required
            placeholder="seu@email.com"
            class="newsletter__input"
            autocomplete="email"
          />
          <Button type="submit" variant="primary" size="md">Quero</Button>
        </div>
        <p class="newsletter__hint" data-newsletter-msg aria-live="polite"></p>
      </form>
    </div>

    {cols.map((col) => (
      <nav class="site-footer__col" aria-label={col.title}>
        <h3 class="site-footer__coltitle">{col.title}</h3>
        <ul>
          {col.links.map((l) => (
            <li><a href={l.href} class="site-footer__link">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} Besties Cookie’n Brownie · CNPJ 00.000.000/0001-00</p>
    <p class="site-footer__made">feito com massa de cookie 🍪</p>
    <ul class="site-footer__social" aria-label="Redes sociais">
      <li><a href="https://www.instagram.com/bestiescookie/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a></li>
    </ul>
  </div>

  <p class="site-footer__credit">
    Desenvolvido por
    <a href="https://kadosh-tech.vercel.app/" target="_blank" rel="noopener noreferrer">Kadosh Tech</a>
  </p>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--space-3xl);
    background: rgb(var(--besties-grape-900-rgb));
    color: rgb(var(--besties-cream-50-rgb) / 0.85);
    padding-bottom: var(--space-lg);
  }

  /* borda superior ondulada = mordidas de cookie */
  .site-footer__scallop {
    position: absolute;
    top: -18px; left: 0; right: 0;
    height: 20px;
    background:
      radial-gradient(22px at 22px 20px, transparent 20px, rgb(var(--besties-grape-900-rgb)) 21px)
      repeat-x;
    background-size: 44px 20px;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-xl);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  .site-footer__name { font-size: 2.4rem; display: inline-block; }
  .site-footer__blurb {
    margin-top: var(--space-sm);
    max-width: 34ch;
    color: rgb(var(--besties-cream-50-rgb) / 0.7);
    font-size: var(--step--1);
  }

  /* newsletter */
  .newsletter { margin-top: var(--space-lg); }
  .newsletter__label {
    display: block;
    font-weight: var(--weight-bold);
    color: rgb(var(--besties-butter-400-rgb));
    margin-bottom: var(--space-xs);
    font-size: var(--step--1);
  }
  .newsletter__row { display: flex; gap: var(--space-xs); max-width: 360px; }
  .newsletter__input {
    flex: 1;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-pill);
    border: 2px solid rgb(var(--besties-cream-50-rgb) / 0.2);
    background: rgb(var(--besties-cream-50-rgb) / 0.06);
    color: var(--color-on-dark);
  }
  .newsletter__input::placeholder { color: rgb(var(--besties-cream-50-rgb) / 0.45); }
  .newsletter__input:focus-visible {
    outline: 3px solid rgb(var(--besties-butter-400-rgb));
    outline-offset: 2px;
  }
  .newsletter__hint { margin-top: var(--space-xs); font-size: var(--step--1); min-height: 1.2em; }

  /* colunas */
  .site-footer__coltitle {
    font-size: var(--step-0);
    color: var(--color-on-dark);
    margin-bottom: var(--space-sm);
  }
  .site-footer__col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .site-footer__link {
    color: rgb(var(--besties-cream-50-rgb) / 0.72);
    font-size: var(--step--1);
    transition: color 0.3s ease-in-out;
  }
  .site-footer__link:hover { color: rgb(var(--besties-butter-400-rgb)); }

  /* bottom bar */
  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-lg);
    border-top: 1px solid rgb(var(--besties-cream-50-rgb) / 0.12);
    font-size: var(--step--1);
    color: rgb(var(--besties-cream-50-rgb) / 0.6);
  }
  .site-footer__made { color: rgb(var(--besties-butter-200-rgb)); }

  .site-footer__credit {
    text-align: center;
    padding-top: var(--space-md);
    font-size: var(--step--1);
    color: rgb(var(--besties-cream-50-rgb) / 0.55);
  }
  .site-footer__credit a {
    color: rgb(var(--besties-butter-400-rgb));
    font-weight: var(--weight-bold);
    transition: color 0.3s ease-in-out;
  }
  .site-footer__credit a:hover { text-decoration: underline; color: rgb(var(--besties-butter-200-rgb)); }
  .site-footer__social ul { display: flex; }
  .site-footer__social { list-style: none; }
  .site-footer__social li { display: inline; }
  .site-footer__social a { color: rgb(var(--besties-cream-50-rgb) / 0.72); margin-left: var(--space-md); }
  .site-footer__social a:hover { color: rgb(var(--besties-butter-400-rgb)); }

  @media (max-width: 860px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .site-footer__grid { grid-template-columns: 1fr; }
    .site-footer__bottom { justify-content: flex-start; }
  }
</style>

<script>
  // Newsletter mock — valida e dá feedback sem back-end ainda.
  const form = document.querySelector('[data-newsletter]') as HTMLFormElement | null;
  const msg = document.querySelector('[data-newsletter-msg]') as HTMLElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value.trim();
    if (!email) return;
    if (msg) {
      msg.textContent = 'Prontinho! Você entrou na lista 🎉 (mock — integrar depois)';
      msg.style.color = 'rgb(var(--besties-butter-400-rgb))';
    }
    form.reset();
  });
</script>