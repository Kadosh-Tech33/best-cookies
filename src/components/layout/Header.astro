---
/**
 * Header — barra roxa da marca (o "canvas" da logo).
 * Wordmark amarelo com sombra 3D caramelo. Nav + carrinho + CTA.
 * Menu mobile acessível (aria-expanded, foco preso simples, Esc fecha).
 * `transparent` = começa translúcido sobre o hero e vira sólido ao rolar.
 */
import Button from '../ui/Button.astro';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const links = [
  { href: '#sabores', label: 'Sabores' },
  { href: '#como-funciona', label: 'Como funciona' },
  { href: '#sobre', label: 'Nossa história' },
  { href: '#contato', label: 'Contato' },
];
---

<header class:list={['site-header', { 'is-transparent': transparent }]} data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Besties Cookie'n Brownie — início">
      <span class="wordmark brand__name">Besties</span>
      <span class="brand__tag">cookie’n brownie</span>
    </a>

    <nav class="nav-desktop" aria-label="Navegação principal">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} class="nav-link">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button variant="ghost" iconOnly size="md" class="cart-btn" aria-label="Abrir carrinho" data-cart-open>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" />
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
        </svg>
        <span class="cart-count" data-cart-count>0</span>
      </Button>

      <Button href="#sabores" variant="primary" size="md" class="header-cta">Montar meu cookie</Button>

      <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Navegação mobile">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} class="mobile-link" data-menu-link>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <Button href="#sabores" variant="primary" size="lg" full>Montar meu cookie</Button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(var(--besties-grape-500-rgb));
    color: var(--color-on-dark);
    border-bottom: 3px solid rgb(var(--besties-grape-900-rgb) / 0.25);
    transition: background 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
  }
  .site-header.is-scrolled { box-shadow: var(--shadow-md); }

  /* transparente sobre o hero, sólido ao rolar (classe via JS) */
  .site-header.is-transparent {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    border-bottom-color: transparent;
  }
  .site-header.is-transparent.is-scrolled {
    background: rgb(var(--besties-grape-500-rgb));
    border-bottom-color: rgb(var(--besties-grape-900-rgb) / 0.25);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 72px;
  }

  /* --- Marca --- */
  .brand { display: flex; flex-direction: column; line-height: 0.9; }
  .brand__name { font-size: 1.9rem; }
  .brand__tag {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--besties-butter-200-rgb));
    margin-top: 0.15em;
    padding-left: 0.15em;
  }

  /* --- Nav desktop --- */
  .nav-desktop ul {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
  }
  .nav-link {
    position: relative;
    font-weight: var(--weight-semibold);
    color: rgb(var(--besties-cream-50-rgb) / 0.9);
    padding: 0.4rem 0;
    transition: color 0.3s ease-in-out;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    width: 100%; height: 3px;
    background: rgb(var(--besties-butter-400-rgb));
    border-radius: 999px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-squish);
  }
  .nav-link:hover { color: rgb(var(--besties-butter-400-rgb)); }
  .nav-link:hover::after { transform: scaleX(1); }

  /* --- Ações --- */
  .site-header__actions { display: flex; align-items: center; gap: var(--space-sm); }

  .cart-btn { position: relative; color: var(--color-on-dark); }
  .cart-btn:hover { background: rgb(var(--besties-cream-50-rgb) / 0.12); }
  .cart-count {
    position: absolute;
    top: -2px; right: -2px;
    min-width: 1.15rem; height: 1.15rem;
    padding: 0 0.25rem;
    display: grid; place-items: center;
    background: rgb(var(--besties-butter-400-rgb));
    color: rgb(var(--besties-grape-900-rgb));
    font-family: var(--font-body);
    font-size: 0.68rem; font-weight: var(--weight-bold);
    border-radius: 999px;
    border: 2px solid rgb(var(--besties-grape-500-rgb));
  }

  /* --- Botão hambúrguer --- */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    width: 44px; height: 44px;
    padding: 0 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .menu-toggle span {
    display: block; width: 24px; height: 3px;
    background: var(--color-on-dark);
    border-radius: 999px;
    transition: transform 0.3s ease-in-out, opacity 0.2s linear;
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* --- Menu mobile --- */
  .mobile-menu {
    background: rgb(var(--besties-grape-700-rgb));
    padding: var(--space-lg) var(--container-pad) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .mobile-link {
    display: block;
    padding: var(--space-sm) 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--color-on-dark);
    border-bottom: 2px solid rgb(var(--besties-cream-50-rgb) / 0.12);
  }
  .mobile-link:hover { color: rgb(var(--besties-butter-400-rgb)); }

  /* --- Responsivo --- */
  @media (max-width: 860px) {
    .nav-desktop, .header-cta { display: none; }
    .menu-toggle { display: flex; }
  }
  @media (min-width: 861px) {
    .mobile-menu { display: none !important; }
  }
</style>

<script>
  // Header: sombra/solidez ao rolar + menu mobile acessível.
  const header = document.querySelector('[data-header]') as HTMLElement | null;
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setMenu = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('[data-menu-link]').forEach((a) =>
    a.addEventListener('click', () => setMenu(false))
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setMenu(false);
  });
</script>