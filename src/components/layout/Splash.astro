---
/**
 * Splash — overlay full-screen da "chuva de cookies".
 * Fica por cima de tudo (--z-splash). O Hero já está renderizado por baixo,
 * então o LCP NÃO fica bloqueado por esta animação.
 */
---

<div class="splash" data-splash aria-hidden="true">
  <canvas class="splash__canvas" data-splash-canvas></canvas>
  <div class="splash__logo" data-splash-logo>
    <span class="wordmark splash__name">Besties</span>
    <span class="splash__tag">cookie’n brownie</span>
  </div>
</div>

<style>
  .splash {
    position: fixed;
    inset: 0;
    z-index: var(--z-splash);
    display: none;                 /* oculto por padrão → sem flash roxo */
    place-items: center;
    background: rgb(var(--besties-grape-500-rgb));
    /* fade-out explícito e suave, desacoplado dos tokens (não some seco) */
    transition: opacity 0.6s ease-in-out, transform 0.6s ease-in-out;
    will-change: opacity, transform;
  }
  .splash.is-active { display: grid; }  /* ativado pelo JS quando vai animar */
  .splash.is-done {
    opacity: 0;
    transform: scale(1.03);
    pointer-events: none;
  }

  .splash__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .splash__logo {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    animation: splash-pop var(--dur-slow) var(--ease-squish) both;
  }
  .splash__name { font-size: clamp(3rem, 12vw, 6rem); line-height: 0.9; }
  .splash__tag {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-size: clamp(0.7rem, 2.4vw, 1rem);
    color: rgb(var(--besties-butter-200-rgb));
    margin-top: 0.4em;
  }

  @keyframes splash-pop {
    from { opacity: 0; transform: scale(0.82) translateY(12px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>

<script>
  import { initSplash } from '../../animations/cookieRain';
  initSplash();
</script>