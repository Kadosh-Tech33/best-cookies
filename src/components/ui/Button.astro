---
/**
 * Button — átomo base da Besties.
 * Polimórfico: renderiza <a> se `href` for passado, senão <button>.
 * Assinatura: "squish" no :active (afunda + sombra encolhe) com ease back.
 *
 * @example
 *   <Button variant="primary" size="lg">Montar meu cookie</Button>
 *   <Button href="/loja" variant="secondary">Ver sabores</Button>
 *   <Button variant="outline" size="sm" iconOnly aria-label="Carrinho">🛒</Button>
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
  full?: boolean;        // ocupa 100% da largura
  iconOnly?: boolean;    // botão quadrado só com ícone
  class?: string;
  [key: string]: any;    // passthrough (aria-*, data-*, id, target, rel...)
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  loading = false,
  full = false,
  iconOnly = false,
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const tagProps = href
  ? { href: disabled ? undefined : href, 'aria-disabled': disabled ? 'true' : undefined, role: 'button' }
  : { type, disabled: disabled || loading };
---

<Tag
  class:list={[
    'btn',
    `btn--${variant}`,
    `btn--${size}`,
    { 'btn--full': full, 'btn--icon': iconOnly, 'btn--loading': loading },
    className,
  ]}
  data-loading={loading ? '' : undefined}
  {...tagProps}
  {...rest}
>
  {loading && <span class="btn__spinner" aria-hidden="true"></span>}
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    --_bg: transparent;
    --_fg: var(--color-ink);
    --_bg-hover: transparent;
    --_shadow: none;
    --_border: transparent;

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);

    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    letter-spacing: 0.01em;
    line-height: 1;
    white-space: nowrap;
    text-align: center;

    color: var(--_fg);
    background-color: var(--_bg);
    border: 2px solid var(--_border);
    border-radius: var(--radius-pill);
    box-shadow: var(--_shadow);

    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* Durações CRAVADAS (não passam por var(--dur-*), que o reduced-motion
       poderia zerar). Cor/sombra/borda suaves em 0.3s; transform rápido
       em 0.12s para o "squish" do clique continuar seco. */
    transition:
      color 0.3s ease-in-out,
      background-color 0.3s ease-in-out,
      border-color 0.3s ease-in-out,
      box-shadow 0.3s ease-in-out,
      transform 0.12s var(--ease-squish);
  }

  /* --- assinatura: squish ao pressionar --- */
  .btn:not([disabled]):not([aria-disabled='true']):hover {
    background-color: var(--_bg-hover);
    transform: translateY(-2px);
  }
  .btn:not([disabled]):not([aria-disabled='true']):active {
    transform: translateY(1px) scale(0.97);
    box-shadow: none;
  }

  .btn:focus-visible {
    outline: 3px solid var(--color-ring);
    outline-offset: 3px;
  }

  /* --- variantes --- */
  .btn--primary {
    --_bg: var(--color-primary);
    --_fg: var(--color-on-primary);
    --_bg-hover: var(--color-primary-hover);
    --_shadow: var(--shadow-primary);
    --_border: var(--color-primary);
  }
  .btn--primary:hover { --_border: var(--color-primary-hover); }

  .btn--secondary {
    --_bg: var(--color-secondary);
    --_fg: var(--color-on-secondary);
    --_bg-hover: var(--color-secondary-hover);
    --_shadow: var(--shadow-md);
    --_border: var(--color-secondary);
  }
  .btn--secondary:hover { --_border: var(--color-secondary-hover); }

  .btn--outline {
    --_bg: transparent;
    --_fg: var(--color-secondary);
    --_bg-hover: var(--color-surface-tint);
    --_border: var(--color-border-strong);
  }
  .btn--outline:hover { --_border: var(--color-secondary); }

  .btn--ghost {
    --_bg: transparent;
    --_fg: var(--color-ink);
    --_bg-hover: var(--color-surface-tint);
    --_border: transparent;
  }

  /* --- tamanhos --- */
  .btn--sm { padding: 0.5rem 1rem; font-size: var(--step--1); }
  .btn--md { padding: 0.75rem 1.5rem; font-size: var(--step-0); }
  .btn--lg { padding: 1rem 2rem; font-size: var(--step-1); }

  .btn--full { width: 100%; }

  .btn--icon { padding: 0; aspect-ratio: 1; }
  .btn--icon.btn--sm { width: 2.25rem; }
  .btn--icon.btn--md { width: 2.75rem; }
  .btn--icon.btn--lg { width: 3.25rem; }

  /* --- estados --- */
  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .btn--loading { cursor: progress; }
  .btn--loading .btn__label { opacity: 0.6; }

  .btn__spinner {
    width: 1em;
    height: 1em;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: btn-spin 0.7s linear infinite;
  }

  @keyframes btn-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn:hover,
    .btn:active { transform: none; }
    .btn__spinner { animation-duration: 1.2s; }
  }
</style>