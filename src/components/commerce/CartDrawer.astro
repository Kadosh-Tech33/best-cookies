---
/**
 * CartDrawer — gaveta lateral (slide-over) do carrinho.
 * Renderização vanilla assinando os stores (sem framework).
 * Deve ser montada 1x globalmente (no Layout).
 */
import Button from '../ui/Button.astro';
---

<div class="cart" data-cart aria-hidden="true">
  <div class="cart__backdrop" data-cart-backdrop></div>

  <aside class="cart__panel" role="dialog" aria-modal="true" aria-label="Seu carrinho">
    <header class="cart__head">
      <h2 class="cart__title">
        Seu carrinho <span class="cart__count" data-cart-count-label></span>
      </h2>
      <button class="cart__close" data-cart-close aria-label="Fechar carrinho" type="button">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="cart__scroll" data-lenis-prevent>
      <ul class="cart__list" data-cart-list></ul>

      <div class="cart__empty" data-cart-empty>
        <div class="cart__empty-emoji" aria-hidden="true">🍪</div>
        <p class="cart__empty-text">Seu carrinho está vazio.</p>
        <a class="cart__empty-cta" href="/loja" data-cart-close>Ver sabores →</a>
      </div>
    </div>

    <footer class="cart__foot" data-cart-foot hidden>
      <div class="cart__ship" data-cart-ship aria-live="polite"></div>
      <div class="cart__subtotal">
        <span>Subtotal</span>
        <strong data-cart-subtotal>R$ 0,00</strong>
      </div>
      <Button href="/checkout" variant="primary" size="lg" full>Finalizar pedido</Button>
      <button class="cart__clear" data-cart-clear type="button">Esvaziar carrinho</button>
    </footer>
  </aside>
</div>

<style>
  .cart { position: fixed; inset: 0; z-index: var(--z-drawer); pointer-events: none; }

  .cart__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(var(--besties-grape-900-rgb) / 0.5);
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }

  .cart__panel {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: min(420px, 92vw);
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    box-shadow: var(--shadow-lg);
    transform: translateX(100%);
    transition: transform 0.42s cubic-bezier(0.5, 0, 0.2, 1);
    will-change: transform;
  }

  /* aberto */
  .cart.is-open { pointer-events: auto; }
  .cart.is-open .cart__backdrop { opacity: 1; }
  .cart.is-open .cart__panel { transform: translateX(0); }

  /* cabeçalho */
  .cart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
    background: rgb(var(--besties-grape-500-rgb));
    color: var(--color-on-dark);
  }
  .cart__title { font-size: var(--step-2); }
  .cart__count { color: rgb(var(--besties-butter-200-rgb)); }
  .cart__close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: var(--radius-pill);
    background: rgb(var(--besties-cream-50-rgb) / 0.14);
    color: var(--color-on-dark);
    cursor: pointer;
    transition: background 0.3s ease-in-out, transform 0.12s var(--ease-squish);
  }
  .cart__close:hover { background: rgb(var(--besties-cream-50-rgb) / 0.26); }
  .cart__close:active { transform: scale(0.92); }

  /* corpo rolável */
  .cart__scroll { flex: 1; overflow-y: auto; padding: var(--space-md) var(--space-lg); }
  .cart__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-md); }

  /* item */
  :global(.citem) {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--space-md);
    align-items: center;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }
  :global(.citem__img) {
    width: 64px; height: 64px;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--color-surface-tint);
  }
  :global(.citem__name) { font-weight: var(--weight-bold); font-size: var(--step-0); line-height: 1.2; }
  :global(.citem__unit) { color: var(--color-ink-faint); font-size: var(--step--1); }

  :global(.citem__qty) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.4rem;
    background: var(--color-surface-tint);
    border-radius: var(--radius-pill);
    padding: 0.15rem;
  }
  :global(.citem__qty button) {
    width: 1.7rem; height: 1.7rem;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-secondary);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.3s ease-in-out, transform 0.12s var(--ease-squish);
  }
  :global(.citem__qty button:hover) { background: var(--color-accent); }
  :global(.citem__qty button:active) { transform: scale(0.9); }
  :global(.citem__qty span) { min-width: 1.4rem; text-align: center; font-weight: var(--weight-bold); }

  :global(.citem__right) { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; height: 100%; }
  :global(.citem__line) { font-family: var(--font-display); font-weight: 800; color: var(--color-secondary); }
  :global(.citem__remove) {
    border: none;
    background: none;
    color: var(--color-ink-faint);
    cursor: pointer;
    font-size: var(--step--1);
    padding: 0.2rem;
    transition: color 0.3s ease-in-out;
  }
  :global(.citem__remove:hover) { color: rgb(var(--besties-danger-rgb)); }

  /* vazio */
  .cart__empty { text-align: center; padding: var(--space-3xl) var(--space-lg); }
  .cart__empty-emoji { font-size: 3rem; margin-bottom: var(--space-sm); }
  .cart__empty-text { color: var(--color-ink-soft); }
  .cart__empty-cta {
    display: inline-block;
    margin-top: var(--space-md);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    transition: color 0.3s ease-in-out;
  }
  .cart__empty-cta:hover { color: var(--color-primary-hover); }

  /* rodapé */
  .cart__foot {
    padding: var(--space-lg);
    border-top: 2px solid var(--color-border);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .cart__foot[hidden] { display: none; }
  .cart__ship {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    color: var(--color-secondary);
    background: var(--color-surface-tint);
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-md);
    text-align: center;
  }
  .cart__subtotal {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: var(--step-1);
  }
  .cart__subtotal strong { font-family: var(--font-display); font-size: var(--step-3); color: var(--color-ink); }
  .cart__clear {
    border: none;
    background: none;
    color: var(--color-ink-faint);
    font-size: var(--step--1);
    cursor: pointer;
    padding: 0.25rem;
    transition: color 0.3s ease-in-out;
  }
  .cart__clear:hover { color: rgb(var(--besties-danger-rgb)); }

  @media (prefers-reduced-motion: reduce) {
    .cart__panel { transition: transform 0.2s ease; }
  }
</style>

<script>
  import {
    cartItems, cartOpen, cartCount, cartSubtotal,
    increment, decrement, removeItem, clearCart, openCart, closeCart,
  } from '../../store/cartStore';
  import { formatBRL, FREE_SHIPPING_CENTS, IMG_FALLBACK } from '../../data/produtos';
  import { getLenis } from '../../animations/smoothScroll';

  const root = document.querySelector<HTMLElement>('[data-cart]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('.cart__panel')!;
    const list = root.querySelector<HTMLElement>('[data-cart-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-cart-empty]')!;
    const foot = root.querySelector<HTMLElement>('[data-cart-foot]')!;
    const subtotalEl = root.querySelector<HTMLElement>('[data-cart-subtotal]')!;
    const shipEl = root.querySelector<HTMLElement>('[data-cart-ship]')!;
    const countLabel = root.querySelector<HTMLElement>('[data-cart-count-label]')!;
    const headerBadge = document.querySelector<HTMLElement>('[data-cart-count]');
    const closeBtn = root.querySelector<HTMLElement>('[data-cart-close]');

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    // --- Render da lista -------------------------------------------------
    const render = () => {
      const items = Object.values(cartItems.get());
      const subtotal = cartSubtotal.get();

      if (items.length === 0) {
        list.innerHTML = '';
        empty.hidden = false;
        foot.hidden = true;
        return;
      }
      empty.hidden = true;
      foot.hidden = false;

      list.innerHTML = items
        .map(
          (i) => `
        <li class="citem" data-id="${i.id}">
          <img class="citem__img" src="${esc(i.image)}" alt="${esc(i.name)}"
               onerror="this.onerror=null;this.src='${IMG_FALLBACK}';" />
          <div class="citem__info">
            <p class="citem__name">${esc(i.name)}</p>
            <p class="citem__unit">${formatBRL(i.priceCents)} / un.</p>
            <div class="citem__qty">
              <button data-dec aria-label="Diminuir quantidade">−</button>
              <span>${i.qty}</span>
              <button data-inc aria-label="Aumentar quantidade">+</button>
            </div>
          </div>
          <div class="citem__right">
            <button class="citem__remove" data-remove aria-label="Remover ${esc(i.name)}">Remover</button>
            <span class="citem__line">${formatBRL(i.priceCents * i.qty)}</span>
          </div>
        </li>`
        )
        .join('');

      // totais + progresso de frete grátis
      subtotalEl.textContent = formatBRL(subtotal);
      if (subtotal >= FREE_SHIPPING_CENTS) {
        shipEl.textContent = '🎉 Você ganhou frete grátis!';
      } else {
        shipEl.textContent = `Faltam ${formatBRL(FREE_SHIPPING_CENTS - subtotal)} para o frete grátis`;
      }
    };

    // --- Badge do header -------------------------------------------------
    const renderCount = (n: number) => {
      countLabel.textContent = n > 0 ? `(${n})` : '';
      if (headerBadge) {
        headerBadge.textContent = String(n);
        headerBadge.style.display = n > 0 ? 'grid' : 'none';
      }
    };

    // --- Abrir/fechar ----------------------------------------------------
    const setOpen = (open: boolean) => {
      root.classList.toggle('is-open', open);
      root.setAttribute('aria-hidden', String(!open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      const lenis = getLenis();
      if (open) lenis?.stop(); else lenis?.start();
      if (open) closeBtn?.focus();
    };

    // --- Assinaturas (subscribe dispara na hora com o valor atual) -------
    cartItems.subscribe(render);
    cartCount.subscribe(renderCount);
    cartOpen.subscribe(setOpen);

    // --- Interações ------------------------------------------------------
    // Abrir a partir do header (data-cart-open)
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-cart-open]')) {
        e.preventDefault();
        openCart();
      }
    });

    // Fechar: botão(s) data-cart-close e backdrop
    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-cart-close]') || t.closest('[data-cart-backdrop]')) {
        closeCart();
      }
    });

    // Esc fecha
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && cartOpen.get()) closeCart();
    });

    // +/- e remover (delegação na lista)
    list.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const li = t.closest<HTMLElement>('.citem');
      if (!li) return;
      const id = li.dataset.id!;
      if (t.closest('[data-inc]')) increment(id);
      else if (t.closest('[data-dec]')) decrement(id);
      else if (t.closest('[data-remove]')) removeItem(id);
    });

    // Esvaziar
    root.querySelector('[data-cart-clear]')?.addEventListener('click', () => clearCart());
  }
</script>