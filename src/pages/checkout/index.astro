---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
---

<Layout title="Checkout — Besties" description="Finalize seu pedido de cookies artesanais.">
  <section class="co container">
    <h1 class="co__title">Finalizar pedido</h1>

    <!-- Carrinho vazio -->
    <div class="co__empty" data-co-empty hidden>
      <div class="co__empty-emoji" aria-hidden="true">🛒</div>
      <p>Seu carrinho está vazio.</p>
      <Button href="/loja" variant="primary" size="lg">Ver sabores</Button>
    </div>

    <div class="co__grid" data-co-grid>
      <!-- Formulário -->
      <div class="co__form">
        <fieldset class="co__section">
          <legend>1 · Contato</legend>
          <div class="field"><label for="nome">Nome completo</label><input id="nome" name="nome" autocomplete="name" required /></div>
          <div class="field-row">
            <div class="field"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
            <div class="field"><label for="tel">Telefone / WhatsApp</label><input id="tel" name="tel" inputmode="tel" autocomplete="tel" placeholder="(11) 90000-0000" /></div>
          </div>
        </fieldset>

        <fieldset class="co__section">
          <legend>2 · Entrega</legend>
          <div class="field-row">
            <div class="field field--cep">
              <label for="cep">CEP</label>
              <div class="cep-row">
                <input id="cep" name="cep" inputmode="numeric" placeholder="00000-000" data-cep required />
                <Button type="button" variant="outline" size="sm" data-calc-frete>Calcular</Button>
              </div>
              <span class="field__hint" data-cep-status></span>
            </div>
          </div>
          <div class="field-row">
            <div class="field field--grow"><label for="endereco">Endereço</label><input id="endereco" name="endereco" data-f-endereco autocomplete="address-line1" /></div>
            <div class="field field--num"><label for="numero">Número</label><input id="numero" name="numero" data-f-numero /></div>
          </div>
          <div class="field-row">
            <div class="field"><label for="compl">Complemento</label><input id="compl" name="compl" placeholder="opcional" /></div>
            <div class="field"><label for="bairro">Bairro</label><input id="bairro" name="bairro" data-f-bairro /></div>
          </div>
          <div class="field-row">
            <div class="field field--grow"><label for="cidade">Cidade</label><input id="cidade" name="cidade" data-f-cidade /></div>
            <div class="field field--uf"><label for="uf">UF</label><input id="uf" name="uf" maxlength="2" data-f-uf /></div>
          </div>
        </fieldset>

        <fieldset class="co__section">
          <legend>3 · Entrega</legend>
          <div class="frete" data-frete-options>
            <p class="frete__placeholder">Informe o CEP e clique em <strong>Calcular</strong> para ver as opções de entrega.</p>
          </div>
        </fieldset>

        <fieldset class="co__section">
          <legend>4 · Pagamento</legend>
          <div class="pay">
            <label class="pay__opt"><input type="radio" name="pay" value="pix" checked data-pay /><span class="pay__label">Pix <em>· 5% de desconto</em></span></label>
            <label class="pay__opt"><input type="radio" name="pay" value="cartao" data-pay /><span class="pay__label">Cartão de crédito <em>· até 12x</em></span></label>
            <label class="pay__opt"><input type="radio" name="pay" value="boleto" data-pay /><span class="pay__label">Boleto <em>· vence em 3 dias</em></span></label>
          </div>
          <div class="pay__panel" data-pay-panel></div>
        </fieldset>
      </div>

      <!-- Resumo -->
      <aside class="co__summary">
        <div class="summary">
          <h2 class="summary__title">Resumo</h2>
          <ul class="summary__items" data-summary-items></ul>
          <dl class="summary__totals">
            <div><dt>Subtotal</dt><dd data-sum-subtotal>R$ 0,00</dd></div>
            <div data-sum-ship-row hidden><dt>Frete</dt><dd data-sum-ship>—</dd></div>
            <div class="summary__discount" data-sum-disc-row hidden><dt>Desconto Pix</dt><dd data-sum-disc>—</dd></div>
            <div class="summary__total"><dt>Total</dt><dd data-sum-total>R$ 0,00</dd></div>
          </dl>
          <p class="summary__err" data-co-err hidden></p>
          <Button variant="primary" size="lg" full data-pay-now>Pagar agora</Button>
          <p class="summary__note">🔒 Ambiente simulado — nenhuma cobrança real. Integração Mercado Pago entra com as credenciais.</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .co { padding-block: var(--space-2xl) var(--space-3xl); }
  .co__title { font-size: var(--step-4); margin-bottom: var(--space-xl); }

  .co__empty { text-align: center; padding: var(--space-3xl); }
  .co__empty-emoji { font-size: 3rem; margin-bottom: var(--space-md); }

  .co__grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: var(--space-2xl); align-items: start; }

  .co__section {
    border: none;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin-bottom: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }
  .co__section legend {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-1);
    color: var(--color-secondary);
    padding: 0 0 var(--space-sm);
  }

  .field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: var(--space-md); flex: 1; }
  .field-row { display: flex; gap: var(--space-md); flex-wrap: wrap; }
  .field--grow { flex: 2; }
  .field--num { flex: 0 0 90px; }
  .field--uf { flex: 0 0 70px; }
  .field label { font-weight: var(--weight-semibold); font-size: var(--step--1); color: var(--color-ink-soft); }
  .field input {
    padding: 0.7rem 0.9rem;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    transition: border-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
  }
  .field input:focus-visible { outline: none; border-color: var(--color-ring); box-shadow: 0 0 0 3px rgb(var(--besties-grape-500-rgb) / 0.2); }
  .field__hint { font-size: var(--step--1); color: var(--color-ink-faint); min-height: 1.1em; }
  .cep-row { display: flex; gap: var(--space-xs); align-items: center; }
  .cep-row input { flex: 1; }

  /* frete */
  .frete__placeholder { color: var(--color-ink-faint); font-size: var(--step--1); }
  .frete__opt {
    display: flex; align-items: center; gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-xs);
    cursor: pointer;
    transition: border-color 0.3s ease-in-out, background 0.3s ease-in-out;
  }
  .frete__opt:hover { border-color: var(--color-border-strong); }
  .frete__opt:has(input:checked) { border-color: var(--color-secondary); background: var(--color-surface-tint); }
  .frete__opt-main { flex: 1; }
  .frete__opt-eta { font-size: var(--step--1); color: var(--color-ink-faint); }
  .frete__opt-price { font-weight: var(--weight-bold); color: var(--color-secondary); }

  /* pagamento */
  .pay { display: flex; flex-direction: column; gap: var(--space-xs); }
  .pay__opt {
    display: flex; align-items: center; gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color 0.3s ease-in-out, background 0.3s ease-in-out;
  }
  .pay__opt:has(input:checked) { border-color: var(--color-secondary); background: var(--color-surface-tint); }
  .pay__label em { color: var(--color-primary); font-style: normal; font-weight: var(--weight-semibold); font-size: var(--step--1); }
  .pay__panel:empty { display: none; }
  .pay__panel {
    margin-top: var(--space-md);
    padding: var(--space-md);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    color: var(--color-ink-soft);
  }
  .pay__panel .field-row { margin-top: var(--space-sm); }

  /* resumo */
  .co__summary { position: sticky; top: 90px; }
  .summary { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-lg); box-shadow: var(--shadow-md); }
  .summary__title { font-size: var(--step-2); margin-bottom: var(--space-md); }
  .summary__items { list-style: none; padding: 0; margin: 0 0 var(--space-md); display: flex; flex-direction: column; gap: var(--space-sm); max-height: 260px; overflow-y: auto; }
  :global(.sitem) { display: grid; grid-template-columns: 44px 1fr auto; gap: var(--space-sm); align-items: center; font-size: var(--step--1); }
  :global(.sitem img) { width: 44px; height: 44px; object-fit: cover; border-radius: var(--radius-sm); background: var(--color-surface-tint); }
  :global(.sitem__q) { color: var(--color-ink-faint); }
  :global(.sitem__p) { font-weight: var(--weight-bold); }

  .summary__totals { display: flex; flex-direction: column; gap: 0.5rem; padding: var(--space-md) 0; border-top: 2px solid var(--color-border); }
  .summary__totals > div { display: flex; justify-content: space-between; }
  .summary__totals dt { color: var(--color-ink-soft); }
  .summary__discount dd { color: rgb(var(--besties-success-rgb)); font-weight: var(--weight-bold); }
  .summary__total { font-size: var(--step-1); font-weight: var(--weight-bold); padding-top: 0.5rem; border-top: 1px dashed var(--color-border-strong); }
  .summary__total dd { font-family: var(--font-display); font-size: var(--step-3); color: var(--color-ink); }
  .summary__err { color: rgb(var(--besties-danger-rgb)); font-size: var(--step--1); margin-bottom: var(--space-sm); }
  .summary__note { font-size: var(--step--1); color: var(--color-ink-faint); text-align: center; margin-top: var(--space-sm); }

  @media (max-width: 900px) {
    .co__grid { grid-template-columns: 1fr; }
    .co__summary { position: static; }
  }
</style>

<script>
  import { cartItems, cartSubtotal } from '../../store/cartStore';
  import { formatBRL, FREE_SHIPPING_CENTS, IMG_FALLBACK } from '../../data/produtos';

  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel);

  const grid = $('[data-co-grid]');
  const emptyBox = $('[data-co-empty]');
  const itemsEl = $('[data-summary-items]');
  const subEl = $('[data-sum-subtotal]');
  const shipRow = $('[data-sum-ship-row]');
  const shipEl = $('[data-sum-ship]');
  const discRow = $('[data-sum-disc-row]');
  const discEl = $('[data-sum-disc]');
  const totalEl = $('[data-sum-total]');
  const errEl = $('[data-co-err]');
  const freteBox = $('[data-frete-options]');
  const payPanel = $('[data-pay-panel]');

  type Ship = { id: string; label: string; cents: number; eta: string };
  let shipping: Ship | null = null;
  let payment = 'pix';

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  // --- Estado vazio / resumo ------------------------------------------------
  const renderSummary = () => {
    const items = Object.values(cartItems.get());
    const subtotal = cartSubtotal.get();

    if (items.length === 0) {
      grid?.setAttribute('hidden', '');
      emptyBox?.removeAttribute('hidden');
      return;
    }
    grid?.removeAttribute('hidden');
    emptyBox?.setAttribute('hidden', '');

    if (itemsEl) {
      itemsEl.innerHTML = items
        .map(
          (i) => `<li class="sitem">
            <img src="${esc(i.image)}" alt="${esc(i.name)}" onerror="this.onerror=null;this.src='${IMG_FALLBACK}';" />
            <span>${esc(i.name)} <span class="sitem__q">×${i.qty}</span></span>
            <span class="sitem__p">${formatBRL(i.priceCents * i.qty)}</span>
          </li>`
        )
        .join('');
    }
    updateTotals();
  };

  const updateTotals = () => {
    const subtotal = cartSubtotal.get();
    const ship = shipping?.cents ?? 0;
    const discount = payment === 'pix' ? Math.round(subtotal * 0.05) : 0;
    const total = subtotal + ship - discount;

    if (subEl) subEl.textContent = formatBRL(subtotal);
    if (shipping && shipRow && shipEl) {
      shipRow.removeAttribute('hidden');
      shipEl.textContent = ship === 0 ? 'Grátis' : formatBRL(ship);
    }
    if (discRow && discEl) {
      if (discount > 0) { discRow.removeAttribute('hidden'); discEl.textContent = '− ' + formatBRL(discount); }
      else discRow.setAttribute('hidden', '');
    }
    if (totalEl) totalEl.textContent = formatBRL(total);
  };

  // --- Entrega local (mock) + viaCEP (real) --------------------------------
  const mockFrete = (_cep?: string): Ship[] => {
    const subtotal = cartSubtotal.get();
    const motoGratis = subtotal >= FREE_SHIPPING_CENTS;
    return [
      { id: 'motoboy', label: 'Entrega por Motoboy (Expressa)', cents: motoGratis ? 0 : 1200, eta: 'pronto em até 45 min' },
      { id: 'retirada', label: 'Retirar na loja', cents: 0, eta: 'pronto em até 30 min' },
    ];
  };

  const renderFrete = (cep: string) => {
    const opts = mockFrete(cep);
    if (!freteBox) return;
    freteBox.innerHTML = opts
      .map(
        (o, idx) => `<label class="frete__opt">
          <input type="radio" name="frete" value="${o.id}" ${idx === 0 ? 'checked' : ''} />
          <span class="frete__opt-main"><strong>${o.label}</strong><br><span class="frete__opt-eta">${o.eta}</span></span>
          <span class="frete__opt-price">${o.cents === 0 ? 'Grátis' : formatBRL(o.cents)}</span>
        </label>`
      )
      .join('');
    shipping = opts[0];
    freteBox.querySelectorAll<HTMLInputElement>('input[name="frete"]').forEach((r) =>
      r.addEventListener('change', () => { shipping = opts.find((o) => o.id === r.value) ?? null; updateTotals(); })
    );
    updateTotals();
  };

  const lookupCep = async (raw: string) => {
    const cep = raw.replace(/\D/g, '');
    const status = $('[data-cep-status]');
    if (cep.length !== 8) { if (status) status.textContent = 'CEP deve ter 8 dígitos.'; return; }
    if (status) status.textContent = 'Buscando endereço…';
    try {
      const r = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
      const d = await r.json();
      if (!d.erro) {
        ($('[data-f-endereco]') as HTMLInputElement).value = d.logradouro || '';
        ($('[data-f-bairro]') as HTMLInputElement).value = d.bairro || '';
        ($('[data-f-cidade]') as HTMLInputElement).value = d.localidade || '';
        ($('[data-f-uf]') as HTMLInputElement).value = d.uf || '';
        if (status) status.textContent = '✓ Endereço encontrado.';
      } else if (status) status.textContent = 'CEP não encontrado — preencha manualmente.';
    } catch {
      if (status) status.textContent = 'Não deu para consultar o CEP agora — preencha manualmente.';
    }
    renderFrete(cep);
  };

  $('[data-calc-frete]')?.addEventListener('click', () => lookupCep(($('[data-cep]') as HTMLInputElement).value));
  $('[data-cep]')?.addEventListener('blur', (e) => {
    const v = (e.target as HTMLInputElement).value;
    if (v.replace(/\D/g, '').length === 8) lookupCep(v);
  });

  // --- Máscaras de UX (CEP #####-###, celular (##) #####-####) --------------
  const maskCep = (v: string) => {
    const d = v.replace(/\D/g, '').slice(0, 8);
    return d.length > 5 ? `${d.slice(0, 5)}-${d.slice(5)}` : d;
  };
  const maskPhone = (v: string) => {
    const d = v.replace(/\D/g, '').slice(0, 11);
    if (!d) return '';
    if (d.length <= 2) return `(${d}`;
    if (d.length <= 6) return `(${d.slice(0, 2)}) ${d.slice(2)}`;
    if (d.length <= 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
    return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
  };
  ($('[data-cep]') as HTMLInputElement)?.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    t.value = maskCep(t.value);
  });
  ($('#tel') as HTMLInputElement)?.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    t.value = maskPhone(t.value);
  });

  // --- Pagamento ------------------------------------------------------------
  const panels: Record<string, string> = {
    pix: '<p>Ao confirmar, geramos um <strong>QR Code Pix</strong> (simulado). Aprovação na hora.</p>',
    cartao:
      '<p>Cartão de crédito (dados simulados — não insira número real):</p>' +
      '<div class="field-row"><div class="field"><label>Número</label><input inputmode="numeric" placeholder="0000 0000 0000 0000" /></div></div>' +
      '<div class="field-row"><div class="field"><label>Validade</label><input placeholder="MM/AA" /></div><div class="field"><label>CVV</label><input inputmode="numeric" placeholder="123" /></div></div>',
    boleto: '<p>O <strong>boleto</strong> (simulado) vence em 3 dias úteis. O pedido é separado após a compensação.</p>',
  };
  const renderPanel = () => { if (payPanel) payPanel.innerHTML = panels[payment] ?? ''; };
  document.querySelectorAll<HTMLInputElement>('[data-pay]').forEach((r) =>
    r.addEventListener('change', () => { if (r.checked) { payment = r.value; renderPanel(); updateTotals(); } })
  );
  renderPanel();

  // --- Pagar (mock → sucesso) ----------------------------------------------
  $('[data-pay-now]')?.addEventListener('click', () => {
    const val = (sel: string) => ($(sel) as HTMLInputElement)?.value.trim();
    const missing =
      !val('#nome') || !val('#email') || !val('#cep') || !val('#endereco') || !val('#numero') || !val('#cidade') || !val('#uf');

    if (missing || !shipping) {
      if (errEl) {
        errEl.hidden = false;
        errEl.textContent = !shipping
          ? 'Calcule o frete e escolha uma opção de entrega.'
          : 'Preencha nome, e-mail e o endereço completo.';
      }
      return;
    }
    if (errEl) errEl.hidden = true;

    const subtotal = cartSubtotal.get();
    const discount = payment === 'pix' ? Math.round(subtotal * 0.05) : 0;
    const total = subtotal + shipping.cents - discount;
    const count = Object.values(cartItems.get()).reduce((n, i) => n + i.qty, 0);

    const order = {
      number: '#BST-' + Date.now().toString().slice(-6),
      name: val('#nome'),
      count,
      subtotalCents: subtotal,
      shippingCents: shipping.cents,
      discountCents: discount,
      totalCents: total,
      payment,
      shipping: shipping.label,
    };
    sessionStorage.setItem('besties:lastOrder', JSON.stringify(order));
    window.location.href = '/checkout/sucesso';
  });

  // --- Init -----------------------------------------------------------------
  cartItems.subscribe(renderSummary);
</script>