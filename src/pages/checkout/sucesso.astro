---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/ui/Button.astro';
---

<Layout title="Pedido confirmado — Besties" description="Seu pedido foi confirmado." noindex>
  <section class="ok container">
    <div class="ok__card">
      <div class="ok__check" aria-hidden="true">
        <svg viewBox="0 0 52 52" width="72" height="72">
          <circle cx="26" cy="26" r="25" fill="none" stroke="currentColor" stroke-width="3" opacity="0.25" />
          <path class="ok__tick" d="M14 27l8 8 16-18" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>

      <h1 class="ok__title">Pedido confirmado! 🍪</h1>
      <p class="ok__lead" data-ok-greeting>Obrigado pela compra!</p>

      <dl class="ok__meta" data-ok-meta hidden>
        <div><dt>Pedido</dt><dd data-ok-number>—</dd></div>
        <div><dt>Itens</dt><dd data-ok-count>—</dd></div>
        <div><dt>Pagamento</dt><dd data-ok-pay>—</dd></div>
        <div class="ok__total"><dt>Total pago</dt><dd data-ok-total>—</dd></div>
      </dl>

      <p class="ok__note">
        Enviamos a confirmação por e-mail (simulado). Assim que os cookies saírem do forno,
        você recebe o código de rastreio.
      </p>

      <div class="ok__actions">
        <Button href="/loja" variant="primary" size="lg">Comprar mais cookies</Button>
        <Button href="/" variant="outline" size="lg">Voltar ao início</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .ok { padding-block: var(--space-3xl); display: grid; place-items: center; }
  .ok__card {
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-2xl);
    max-width: 520px;
    width: 100%;
    text-align: center;
    border-top: 6px solid var(--color-primary);
  }
  .ok__check { color: rgb(var(--besties-success-rgb)); display: grid; place-items: center; margin-bottom: var(--space-md); }
  .ok__tick { stroke-dasharray: 48; stroke-dashoffset: 48; animation: tick 0.6s var(--ease-out) 0.2s forwards; }
  @keyframes tick { to { stroke-dashoffset: 0; } }

  .ok__title { font-size: var(--step-4); }
  .ok__lead { color: var(--color-ink-soft); font-size: var(--step-1); margin-top: var(--space-xs); }

  .ok__meta {
    text-align: left;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    margin: var(--space-xl) 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ok__meta > div { display: flex; justify-content: space-between; }
  .ok__meta dt { color: var(--color-ink-soft); }
  .ok__meta dd { font-weight: var(--weight-bold); }
  .ok__total { padding-top: 0.6rem; border-top: 1px dashed var(--color-border-strong); }
  .ok__total dd { font-family: var(--font-display); font-size: var(--step-2); color: var(--color-secondary); }

  .ok__note { color: var(--color-ink-soft); font-size: var(--step--1); }
  .ok__actions { display: flex; gap: var(--space-md); justify-content: center; flex-wrap: wrap; margin-top: var(--space-xl); }

  @media (prefers-reduced-motion: reduce) {
    .ok__tick { animation: none; stroke-dashoffset: 0; }
  }
</style>

<script>
  import { clearCart } from '../../store/cartStore';
  import { formatBRL } from '../../data/produtos';

  const payLabel: Record<string, string> = { pix: 'Pix', cartao: 'Cartão de crédito', boleto: 'Boleto' };

  // Recupera o snapshot do pedido salvo no checkout.
  let order: any = null;
  try { order = JSON.parse(sessionStorage.getItem('besties:lastOrder') || 'null'); } catch { order = null; }

  if (order) {
    const set = (sel: string, val: string) => { const el = document.querySelector(sel); if (el) el.textContent = val; };
    set('[data-ok-greeting]', `Obrigado, ${order.name?.split(' ')[0] || 'cliente'}! Recebemos seu pedido.`);
    set('[data-ok-number]', order.number);
    set('[data-ok-count]', `${order.count} ${order.count === 1 ? 'item' : 'itens'}`);
    set('[data-ok-pay]', payLabel[order.payment] ?? order.payment);
    set('[data-ok-total]', formatBRL(order.totalCents));
    document.querySelector('[data-ok-meta]')?.removeAttribute('hidden');
    sessionStorage.removeItem('besties:lastOrder');
  }

  // Limpa o carrinho (simula retorno aprovado do Mercado Pago).
  clearCart();
</script>